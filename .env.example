# ---------------------------------------------------------------------------
# OpsPilot environment. Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://opspilot:opspilot_dev_pw@127.0.0.1:5433/opspilot

# --- Model artifact -------------------------------------------------------
# Produced by `python -m ml_pipeline.train`.
ARTIFACT_DIR=./artifacts

# --- Guest sessions -------------------------------------------------------
SESSION_TTL_HOURS=72
# Set both of these in production, where the API and frontend are cross-origin.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (server-side only; never exposed to the browser) -----------------
# Without a key the app still runs: the risk queue and predictions work and
# the Investigate action reports that AI investigation is unavailable.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# --- Cost and rate limits -------------------------------------------------
INVESTIGATIONS_PER_SESSION_PER_DAY=15
INVESTIGATIONS_GLOBAL_PER_HOUR=200
API_REQUESTS_PER_MINUTE=120
