# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json

# Data (raw Olist CSVs are NOT redistributed - see docs/data_audit.md)
data/raw/*
!data/raw/.gitkeep
data/interim/
data/processed/

# ML artifacts. The served model IS committed: it is under 1 MB, the Docker
# image copies it at build time, and a Render build context is the git repo -
# so ignoring it would deploy an API with no model at all. Keeping it tracked
# also means the exact artifact behind every published metric is auditable.
# Regenerate with `python -m ml_pipeline.train`.
artifacts/*
!artifacts/.gitkeep
!artifacts/delivery_risk_model.joblib
!artifacts/delivery_risk_model.meta.json

# Local postgres cluster
.pgdata/
pg_run/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Playwright
frontend/test-results/
frontend/playwright-report/
_probe.py

# Playwright
frontend/test-results/
frontend/playwright-report/

# scratch profiling scripts
_mem*.py
_dbg.py
_probe.py
_bench*.log

# Private working documents: the brief, the plan and the agent instructions.
# Kept locally, never published - they describe how the project was directed,
# which is not part of the product.
.private/
